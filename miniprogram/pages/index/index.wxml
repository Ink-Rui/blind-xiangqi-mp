<view class="page">
  <view class="hero">
    <view class="hero-title">盲下象棋</view>
    <view class="hero-sub">标准象棋盘 · 开局暗置洗牌 · 走完翻开 · 一半棋艺一半运气</view>
  </view>

  <view class="panel">
    <view class="og">
      <view class="og-title">洗牌模式</view>
      <view class="opts">
        <view wx:for="{{opts.shuffle}}" wx:key="v"
          class="opt {{sel.shuffle === item.v ? 'on' : ''}}"
          data-group="shuffle" data-v="{{item.v}}" bindtap="onPick">
          <view class="opt-name">{{item.name}}</view>
          <view class="opt-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>

    <view class="og">
      <view class="og-title">胜负规则</view>
      <view class="opts">
        <view wx:for="{{opts.rule}}" wx:key="v"
          class="opt {{sel.rule === item.v ? 'on' : ''}}"
          data-group="rule" data-v="{{item.v}}" bindtap="onPick">
          <view class="opt-name">{{item.name}}</view>
          <view class="opt-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>

    <view class="og">
      <view class="og-title">对局形式</view>
      <view class="opts">
        <view wx:for="{{opts.play}}" wx:key="v"
          class="opt {{sel.play === item.v ? 'on' : ''}}"
          data-group="play" data-v="{{item.v}}" bindtap="onPick">
          <view class="opt-name">{{item.name}}</view>
          <view class="opt-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>

    <view class="og" wx:if="{{sel.play === 'ai'}}">
      <view class="og-title">陪练难度</view>
      <view class="opts">
        <view wx:for="{{opts.level}}" wx:key="v"
          class="opt {{sel.level === item.v ? 'on' : ''}}"
          data-group="level" data-v="{{item.v}}" bindtap="onPick">
          <view class="opt-name">{{item.name}}</view>
          <view class="opt-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>

    <view class="big" bindtap="onStart">{{sel.play === 'online' ? '创建房间 · 邀请好友' : '开始对局'}}</view>
    <view class="big gray" wx:if="{{sel.play === 'online'}}" bindtap="onJoinRoom">输入房间码加入</view>
    <view class="foot">V1 核心对局：同屏双人 / 三档 AI 陪练 / 邀请好友联机</view>
  </view>
</view>
